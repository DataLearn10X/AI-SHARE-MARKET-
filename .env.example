# AI Share Market Research Agent - Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# Application
APP_NAME="AI Share Market Research Agent"
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Market Data Providers (free tiers available - fill when needed)
# ALPHA_VANTAGE_API_KEY=
# FINNHUB_API_KEY=
# NEWS_API_KEY=

# AI / LLM (optional, for AI research reports)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Database (default: local SQLite)
DATABASE_URL=sqlite:///./database/app.db
